# TredMail environment configuration
# Copy to .env and fill in every secret. Never commit .env.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000/v1
# Public base URL of the tracking routes, embedded in every email (required in production)
TRACKING_BASE_URL=http://localhost:3000/v1/track
CONSOLE_URL=http://localhost:3010
# Comma-separated browser origins allowed to call the API (defaults to CONSOLE_URL)
CORS_ORIGINS=http://localhost:3010
# Set to true when running behind Caddy or another reverse proxy
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=600

# Secrets (no defaults; the API and worker refuse to start without them)
# 32 random bytes, hex encoded: openssl rand -hex 32
TREDMAIL_MASTER_ENCRYPTION_KEY=
# Shared secret for internal MTA callbacks (required in production): openssl rand -hex 32
INTERNAL_API_TOKEN=
# Signs console sessions: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Optional Google sign-in for the console (redirect URI: <CONSOLE_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails per day a workspace may send from the sandbox sender before verifying a domain
SANDBOX_DAILY_LIMIT=50

# Seed: owner login created by `npm run db:seed` (password generated and shown once if unset)
SEED_ADMIN_EMAIL=admin@dovepeakdigital.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://tredmail:tredmail_secret@127.0.0.1:5435/tredmail_db?schema=public

# Queue and cache (Redis)
REDIS_URL=redis://localhost:6389

# Where the worker hands mail over. Development: Mailpit (localhost:1035), or local KumoMTA
# (`docker compose --profile mta up -d`, then localhost:2525). Production: kumomta:2525.
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Development only: accept self-signed certificates from a local relay
SMTP_ALLOW_INVALID_CERTS=false

# Development only: allow webhooks to http://localhost and private networks
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# TredMail's own sending domain (account emails from no-reply@, sandbox from onboarding@)
# and the tracking/bounce hostnames
PRIMARY_DOMAIN=tredmail.dovepeakdigital.com
TRACKING_DOMAIN=track.tredmail.dovepeakdigital.com
BOUNCE_DOMAIN=bounces.tredmail.dovepeakdigital.com
DEFAULT_DKIM_SELECTOR=tredmail

# --- Delivery engine (KumoMTA) ---
# HELO name of the mail server; the server IP's PTR record must point to it
MTA_HOSTNAME=mta1.tredmail.dovepeakdigital.com
# Alerts, and mail sent to postmaster@/abuse@/dmarc@ on PRIMARY_DOMAIN, are emailed here
OPS_EMAIL=
INBOUND_FORWARD_DAILY_LIMIT=200
# First day of IP warm-up (YYYY-MM-DD, UTC). Empty = no daily cap
MTA_WARMUP_START=
# Optional backup provider (its SMTP relay) for mail above the warm-up cap
FALLBACK_SMTP_HOST=
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_SECURE=false
FALLBACK_SMTP_USER=
FALLBACK_SMTP_PASS=

# Data retention: message bodies erased after N days; emails and events deleted after N days
EMAIL_CONTENT_RETENTION_DAYS=30
EMAIL_RECORD_RETENTION_DAYS=395

# Staging only: deliver mail for these addresses or @domains for real (comma separated);
# everything else is still caught by Mailpit. Needs --profile staging-delivery.
STAGING_DELIVERY_ALLOWLIST=
STAGING_DELIVERY_SMTP_HOST=

# --- SMTP relay (apps/smtp-relay) ---
# Applications send with SMTP: username anything, password an API key with emails:send
SMTP_RELAY_HOSTNAME=smtp.tredmail.dovepeakdigital.com
SMTP_RELAY_PORT=2587
SMTP_RELAY_TLS_PORT=
SMTP_RELAY_TLS_CERT=
SMTP_RELAY_TLS_KEY=
