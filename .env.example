# TredMail Environment Configuration Template
# Copy this file to .env and configure your secrets

# Server & Environment
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/v1
CONSOLE_URL=http://localhost:3001

# Master Secret (used for encrypting DKIM private keys in PostgreSQL)
# Generate a random 32-byte hex string (e.g. openssl rand -hex 32)
TREDMAIL_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (PostgreSQL)
DATABASE_URL=postgresql://tredmail:tredmail_secret@127.0.0.1:5435/tredmail_db?schema=public

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6389

# Outbound MTA Connection
# For development/local testing: Use Mailpit (included in docker-compose.yml)
# For production: Point to your local Postal or KumoMTA instance (127.0.0.1:2525)
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Dovepeak Sending & Tracking Domains
PRIMARY_DOMAIN=tredmail.dovepeak.com
TRACKING_DOMAIN=track.tredmail.dovepeak.com
BOUNCE_DOMAIN=bounces.tredmail.dovepeak.com
DEFAULT_DKIM_SELECTOR=tredmail
