# TredMail environment configuration
# Copy to .env and fill in every secret. Never commit .env.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000/v1
# Public base URL of the tracking routes, embedded in every email (required in production)
TRACKING_BASE_URL=http://localhost:3000/v1/track
CONSOLE_URL=http://localhost:3001
# Comma-separated browser origins allowed to call the API (defaults to CONSOLE_URL)
CORS_ORIGINS=http://localhost:3001
# Set to true when running behind Caddy or another reverse proxy
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=600

# Secrets (no defaults; the API and worker refuse to start without them)
# 32 random bytes, hex encoded: openssl rand -hex 32
TREDMAIL_MASTER_ENCRYPTION_KEY=
# Shared secret for internal MTA callbacks (required in production): openssl rand -hex 32
INTERNAL_API_TOKEN=

# Database (PostgreSQL)
DATABASE_URL=postgresql://tredmail:tredmail_secret@127.0.0.1:5435/tredmail_db?schema=public

# Queue and cache (Redis)
REDIS_URL=redis://localhost:6389

# Outbound SMTP relay: Mailpit in development, the MTA in production
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Development only: accept self-signed certificates from a local relay
SMTP_ALLOW_INVALID_CERTS=false

# Development only: allow webhooks to http://localhost and private networks
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Dovepeak sending and tracking domains
PRIMARY_DOMAIN=tredmail.dovepeak.com
TRACKING_DOMAIN=track.tredmail.dovepeak.com
BOUNCE_DOMAIN=bounces.tredmail.dovepeak.com
DEFAULT_DKIM_SELECTOR=tredmail
