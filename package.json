{
  "name": "tredmail",
  "version": "1.0.0",
  "description": "Enterprise-grade self-hosted transactional email platform by Dovepeak Technology",
  "main": "dist/index.js",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/queue.ts",
    "dev:console": "npm run dev --prefix console",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:console\"",
    "build": "tsc",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "test:e2e": "tsx src/tests/e2e.test.ts"
  },
  "keywords": [
    "email",
    "transactional",
    "mta",
    "smtp",
    "resend",
    "postmark",
    "dovepeak",
    "tredmail"
  ],
  "author": "Dovepeak Technology",
  "license": "Proprietary",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.21.2",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "concurrently": "^9.0.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
