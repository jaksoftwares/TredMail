{
  "name": "tredmail",
  "version": "1.2.0",
  "private": true,
  "description": "TredMail transactional email platform by Dovepeak",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @tredmail/api",
    "dev:worker": "npm run dev -w @tredmail/worker",
    "dev:console": "npm run dev --prefix console",
    "dev": "concurrently -n api,worker \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:all": "concurrently -n api,worker,console \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:console\"",
    "build": "npm run build -w @tredmail/api -w @tredmail/worker",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "db:seed": "npm run seed -w @tredmail/api",
    "keys:revoke": "npm run keys:revoke -w @tredmail/api --",
    "test:accounts": "tsx scripts/accounts-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.0.1",
    "eslint": "^10.13.0",
    "prisma": "^5.22.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Dovepeak",
  "license": "UNLICENSED"
}
