{
  "name": "tredmail",
  "version": "1.1.0",
  "description": "Enterprise-grade self-hosted transactional email platform by Dovepeak Technology",
  "main": "dist/index.js",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/queue.ts",
    "dev:console": "npm run dev --prefix console",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:console\"",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/worker/queue.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:prod": "node dist/db/seed.js",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "keys:revoke": "tsx src/cli/revoke-api-key.ts"
  },
  "keywords": [
    "email",
    "transactional",
    "mta",
    "smtp",
    "resend",
    "postmark",
    "dovepeak",
    "tredmail"
  ],
  "author": "Dovepeak Technology",
  "license": "Proprietary",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.21.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "nodemailer": "^10.1.7",
    "prisma": "^7.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^9.0.1",
    "eslint": "^10.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
