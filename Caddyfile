# TredMail edge: automatic HTTPS (Let's Encrypt) and routing.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Console. Auth (/api/auth) and API calls (/v1) go straight to the API on the same origin,
# so session cookies stay first-party; everything else is the Next.js app.
{$CONSOLE_DOMAIN} {
	import security_headers
	encode zstd gzip

	@backend path /api/* /v1/*
	handle @backend {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy console:3000
	}
}

# Public API for applications and SDKs
{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	# MTA callbacks are reached only inside the Docker network
	@internal path /internal/*
	respond @internal 404
	reverse_proxy api:3000
}

# Open and click tracking links embedded in emails
{$TRACKING_DOMAIN} {
	import security_headers
	@tracking path /v1/track/*
	handle @tracking {
		reverse_proxy api:3000
	}
	handle {
		respond 404
	}
}

# Mail hostnames. Caddy only obtains and renews their certificates here; scripts/cert-sync.sh
# copies them to KumoMTA (STARTTLS on port 25) and the SMTP relay (587/465).
{$MTA_HOSTNAME} {$SMTP_RELAY_HOSTNAME} {
	import security_headers
	respond "TredMail mail service by Dovepeak Technologies" 200
}

# MTA-STS (RFC 8461): tells sending servers to require TLS with a valid certificate when they
# deliver to TredMail's domains. Start in "testing" (failures are only reported via TLS-RPT),
# then set MTA_STS_MODE=enforce and bump the id in the _mta-sts TXT records.
mta-sts.{$PRIMARY_DOMAIN} mta-sts.{$BOUNCE_DOMAIN} {
	import security_headers
	handle /.well-known/mta-sts.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<POLICY
			version: STSv1
			mode: {$MTA_STS_MODE}
			mx: {$MTA_HOSTNAME}
			max_age: 604800

			POLICY 200
	}
	handle {
		respond 404
	}
}
